{
  "manifest_version": 3,
  "name": "Threads伴侣",
  "version": "1.0.0",
  "description": "ThreadsFilter - Threads 网页版关键词过滤伴侣，支持用户名、正文及评论区过滤，支持多语言与简繁互通，选中文字右键快速添加屏蔽词，自由切换深浅色主题。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.threads.net/*",
    "*://*.threads.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Threads伴侣",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": [
        "utils/text-normalizer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
